		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "c1c77d69-dc30-4363-a74e-a7af201214bb")
	)
	(label "BTN1"
		(at 175.26 539.75 0)
		(effects (font (size 1.27 1.27)) (justify right bottom))
		(uuid "d2355272-7583-482f-a42b-ef731ac24359")
	)
	(label "BTN2"
		(at 175.26 544.83 0)
		(effects (font (size 1.27 1.27)) (justify right bottom))
		(uuid "889ac9e6-ea02-4136-b8d2-add4b00ae265")
	)
	(text "P1 is J1 and J2 together: the Pico sockets on the Waveshare."
		(exclude_from_sim no)
		(at 130 12 0)
		(effects (font (size 1.4 1.4)))
		(uuid "df6482ec-6b8e-4b26-be23-52b485430be4")
	)
	(text "J1 pins 4 and 5 are 3.3 V on the Waveshare. This hat does not connect them."
		(exclude_from_sim no)
		(at 130 17 0)
		(effects (font (size 1.2 1.2)))
		(uuid "5d7d2d2b-1764-441a-a0b2-94fec2edb210")
	)
	(text "U1 and U2 are UART. U3 is I2C on SDA and SCL. PGND is not ground."
		(exclude_from_sim no)
		(at 130 22 0)
		(effects (font (size 1.2 1.2)))
		(uuid "1d62c6de-ee36-493f-a7e5-fdb6898fc951")
	)
	(text "F1 feeds every 3.3 V load. Header pins 4 and 5 stay open."
		(exclude_from_sim no)
		(at 220 23.37 0)
		(effects (font (size 1.1 1.1)))
		(uuid "4f8d712c-50e8-410f-8c40-cf6c4a8cbca0")
	)
	(text "4-20 mA on J8. Left to right is 1 to 4. 150 ohm to ground, then 1k into the ADC."
		(exclude_from_sim no)
		(at 130 77.09 0)
		(effects (font (size 1.2 1.2)))
		(uuid "825acb0b-6935-4328-9c19-0fa18acd149e")
	)
	(text "Contacts on J7. Left to right: IN1, IN2, IN3, IN4."
		(exclude_from_sim no)
		(at 130 168.53 0)
		(effects (font (size 1.2 1.2)))
		(uuid "b49ae136-1ce2-40e3-93f1-1f917a9612fe")
	)
	(text "1-Wire. Fit one shunt on JP6, or none."
		(exclude_from_sim no)
		(at 130 259.97 0)
		(effects (font (size 1.2 1.2)))
		(uuid "6133b95b-eb0e-4e92-bc5c-65b306454874")
	)
	(text "EZO pH. Plug in. Do not solder the board down."
		(exclude_from_sim no)
		(at 130 366.65 0)
		(effects (font (size 1.2 1.2)))
		(uuid "dd01ba4b-d652-4ed4-bd3f-61a7234afb48")
	)
	(text "EZO ORP. Plug in. Do not solder the board down."
		(exclude_from_sim no)
		(at 130 427.61 0)
		(effects (font (size 1.2 1.2)))
		(uuid "cef09b75-9eea-4d74-a97a-a6edd4bb9442")
	)
	(text "EZO I2C. Switch this module to I2C before you plug it in. Pull-ups are fitted. J16 is the same bus: pin 1 GND toward the USB edge, then 3.3 V, SCL, and SDA toward the screws."
		(exclude_from_sim no)
		(at 130 320.93 0)
		(effects (font (size 1.2 1.2)))
		(uuid "ada36584-e856-4652-b7de-da96cb1ced2e")
	)
	(text "Buttons A and B sit at the USB-left corner. Each switch closes to ground. A 10k pulls the input up to the fused 3.3 V."
		(exclude_from_sim no)
		(at 130 534.29 0)
		(effects (font (size 1.2 1.2)))
		(uuid "4ddd64bf-4bfe-4e37-b53b-9ec9f421be78")
	)
	(text "J17 brings SW1 and SW2 out for enclosure switches. Odd pins are the signals. Even pins are ground."
		(exclude_from_sim no)
		(at 130 575.53 0)
		(effects (font (size 1.2 1.2)))
		(uuid "4453b25e-eca7-4ef7-9b94-2050578902f3")
	)
