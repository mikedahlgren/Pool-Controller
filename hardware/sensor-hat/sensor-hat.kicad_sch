	(label "BTN2"
		(at 175.26 544.83 0)
		(effects (font (size 1.27 1.27)) (justify right bottom))
		(uuid "e2871e55-80b1-4ba4-a208-735dd1c69efe")
	)
	(text "P1 is J1 and J2 together: the Pico sockets on the Waveshare."
		(exclude_from_sim no)
		(at 130 12 0)
		(effects (font (size 1.4 1.4)))
		(uuid "3a330d26-17c1-428e-a81c-1f431456c65a")
	)
	(text "J1 pins 4 and 5 are 3.3 V on the Waveshare. This hat does not connect them."
		(exclude_from_sim no)
		(at 130 17 0)
		(effects (font (size 1.2 1.2)))
		(uuid "4ca16cdb-4241-4df4-90d0-c1a77c2c4fc8")
	)
	(text "U1 and U2 are UART. U3 is I2C on SDA and SCL. PGND is not ground."
		(exclude_from_sim no)
		(at 130 22 0)
		(effects (font (size 1.2 1.2)))
		(uuid "d693f60d-a8ae-40b9-9272-21883564d4bd")
	)
	(text "F1 feeds every 3.3 V load. Header pins 4 and 5 stay open."
		(exclude_from_sim no)
		(at 220 23.37 0)
		(effects (font (size 1.1 1.1)))
		(uuid "bd999a4a-542b-4dde-8f76-ce92fe1e48a2")
	)
	(text "4-20 mA on J8. Left to right is 1 to 4. 150 ohm to ground, then 1k into the ADC."
		(exclude_from_sim no)
		(at 130 77.09 0)
		(effects (font (size 1.2 1.2)))
		(uuid "0908e5b8-98ae-4185-9911-44c7d0034304")
	)
	(text "Contacts on J7. Left to right: IN1, IN2, IN3, IN4."
		(exclude_from_sim no)
		(at 130 168.53 0)
		(effects (font (size 1.2 1.2)))
		(uuid "de05a898-3faa-4df8-8e57-a74076df0007")
	)
	(text "1-Wire. SW3 selects the pull-up. Pin 3 is the data line. Pin 1 is 4.7k, pin 2 is 2.2k, and pin 4 is 1k. The handle toward the USB edge is 4.7k."
		(exclude_from_sim no)
		(at 130 259.97 0)
		(effects (font (size 1.2 1.2)))
		(uuid "1b78fc63-77ac-4980-ac41-8faa1a6c5244")
	)
	(text "EZO pH. Plug in. Do not solder the board down."
		(exclude_from_sim no)
		(at 130 366.65 0)
		(effects (font (size 1.2 1.2)))
		(uuid "9039c0d8-26b6-49b1-8367-5766ec04b28f")
	)
	(text "EZO ORP. Plug in. Do not solder the board down."
		(exclude_from_sim no)
		(at 130 427.61 0)
		(effects (font (size 1.2 1.2)))
		(uuid "7d3bbd85-97d4-4df4-aa59-471c2d291f57")
	)
	(text "EZO I2C. Switch this module to I2C before you plug it in. Pull-ups are fitted. J16 is the same bus: pin 1 GND toward the USB edge, then 3.3 V, SCL, and SDA toward the screws."
		(exclude_from_sim no)
		(at 130 320.93 0)
		(effects (font (size 1.2 1.2)))
		(uuid "a133bd2e-b48b-4b5a-98af-8a969a9ced87")
	)
	(text "Buttons A and B sit at the USB-left corner. Each switch closes to ground. A 10k pulls the input up to the fused 3.3 V."
		(exclude_from_sim no)
		(at 130 534.29 0)
		(effects (font (size 1.2 1.2)))
		(uuid "44cf8a60-769e-4a40-9a28-638b988ec562")
	)
	(text "J17 brings SW1 and SW2 out for enclosure switches. Odd pins are the signals. Even pins are ground."
		(exclude_from_sim no)
		(at 130 575.53 0)
		(effects (font (size 1.2 1.2)))
		(uuid "00651d74-82a0-4d40-b1b8-f71d5e807548")
	)
