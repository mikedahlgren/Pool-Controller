# Copy these into Home Assistant: /config/esphome/secrets.yaml
# Do not commit a real secrets.yaml.

wifi_ssid: "YourWifiName"
wifi_password: "YourWifiPassword"
ap_password: "HotspotFallbackPassword"

# esphome encrypt / ota — generate with: openssl rand -base64 32
pool_controller_api_key: "paste-base64-api-key"
pool_controller_ota_password: "paste-ota-password"

# Dallas DS18B20 64-bit addresses (from ESPHome logs on first 1-Wire scan)
air_temp_id: "0x1234567890ABCDEF"
water_temp_id: "0x1234567890ABCDEF"

# Only if this GitHub repo is private:
# github_token: "ghp_..."
